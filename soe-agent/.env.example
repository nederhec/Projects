# App Registration no Azure AD (client credentials flow)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# SharePoint (Microsoft Graph) — destino: SharePoint/Comite_SOE/Base_Gerencial/
SHAREPOINT_SITE_ID=
SHAREPOINT_FOLDER_PATH=Comite_SOE/Base_Gerencial

# Power BI — workspace e dataset alvo do refresh
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=

# Origem permitida para CORS (URL onde o front-end SOEAgent.jsx é servido)
FRONTEND_ORIGIN=http://localhost:5173

PORT=4000
