# App Registration no Azure AD (client credentials flow)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# SharePoint (Microsoft Graph) — destino: SharePoint/Comite_SOE/Base_Gerencial/
SHAREPOINT_SITE_ID=
SHAREPOINT_FOLDER_PATH=Comite_SOE/Base_Gerencial

# Power BI — workspace e dataset alvo do refresh
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=

# Claude API (Etapa 8 — Análise Executiva). Gerar em console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Alertas por e-mail via Microsoft Graph sendMail (Etapa 9).
# Reaproveita o mesmo App Registration acima — requer permissão de aplicativo Mail.Send
# concedida com consentimento de administrador, e uma caixa de correio válida no tenant.
GRAPH_SENDER_UPN=
# Destinatários padrão (separados por vírgula) quando o front-end não informar "to"
ALERT_RECIPIENTS=comite-soe@proteina-sul.com.br

# Origem permitida para CORS (URL onde o front-end SOEAgent.jsx é servido)
FRONTEND_ORIGIN=http://localhost:5173

PORT=4000
