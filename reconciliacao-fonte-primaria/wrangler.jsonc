{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // O nome aqui precisa bater com o nome do Worker criado no painel da
  // Cloudflare (Workers Builds exige isso pra conectar o repositório).
  "name": "apura-folha-app",
  "compatibility_date": "2026-07-12",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Obrigatório: sem isso, os assets estáticos são servidos direto e
    // o worker.js (o Basic Auth) nunca roda. Ver comentário em worker.js.
    "run_worker_first": true
  }
}
